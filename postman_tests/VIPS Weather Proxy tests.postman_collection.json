		{
			"name": "VitiMeteo (FIBL/Agroscope) Hourly data",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Weather data have no timestamp duplicates\", function () {",
							"    var jsonData = pm.response.json();",
							"    var lastTimestamp = null;",
							"    for(var i=0;i<jsonData.length;i++)",
							"    {",
							"        ",
							"        var weatherObservation = jsonData[i];",
							"        if(weatherObservation[\"elementMeasurementTypeId\"] == \"TM\")",
							"        {",
							"            console.info(lastTimestamp);",
							"            if(lastTimestamp != null)",
							"            {",
							"                pm.expect(weatherObservation[\"timeMeasured\"]).to.not.eql(lastTimestamp);",
							"                ",
							"            }",
							"            lastTimestamp = weatherObservation[\"timeMeasured\"];",
							"        }",
							"    }",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
